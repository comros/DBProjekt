<%- include('../partials/header') %>
<div class="admin-layout">
  <%- include('./admin-nav') %>
  <main class="admin-main">
    <h1><%= product ? 'Edytuj produkt' : 'Dodaj produkt' %></h1>

    <form method="POST" action="<%= product ? '/admin/products/edit/'+product._id : '/admin/products/add' %>" enctype="multipart/form-data" class="admin-form">

      <div class="form-row">
        <div class="form-group">
          <label>Nazwa produktu *</label>
          <input type="text" name="name" required value="<%= product ? product.name : '' %>">
        </div>
        <div class="form-group">
          <label>Slug (URL) *</label>
          <input type="text" name="slug" required value="<%= product ? product.slug : '' %>" placeholder="np. laptop-probook-x15">
        </div>
      </div>

      <div class="form-group">
        <label>Opis</label>
        <textarea name="description" rows="4"><%= product ? product.description : '' %></textarea>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label>Cena (zł) *</label>
          <input type="number" name="price" step="0.01" min="0" required value="<%= product ? product.price : '' %>">
        </div>
        <div class="form-group">
          <label>Ilość na magazynie *</label>
          <input type="number" name="stock" min="0" required value="<%= product ? product.stock : 0 %>">
        </div>
        <div class="form-group">
          <label>Kategoria *</label>
          <select name="category_id" required>
            <% categories.forEach(cat => { %>
              <option value="<%= cat.id %>" <%= product && product.category_id === cat.id ? 'selected' : '' %>><%= cat.name %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label>Zdjęcia produktu</label>
        <input type="file" name="images" multiple accept="image/*">
        <% if (product && product.images && product.images.length) { %>
          <div class="existing-images">
            <% product.images.forEach(img => { %>
              <img src="<%= img %>" alt="zdjęcie" style="height:60px; margin:4px; border-radius:4px;">
            <% }) %>
          </div>
        <% } %>
      </div>

      <!-- Atrybuty dynamiczne -->
      <div class="form-group">
        <label>Atrybuty (specyfikacja)</label>
        <div id="attrs-container">
          <% if (product && product.attributes && product.attributes.size > 0) { %>
            <% for (const [k, v] of product.attributes) { %>
              <div class="attr-row">
                <input type="text" name="attributes_keys" placeholder="Nazwa (np. RAM)" value="<%= k %>">
                <input type="text" name="attributes_vals" placeholder="Wartość (np. 16GB)" value="<%= v %>">
                <button type="button" onclick="this.parentElement.remove()" class="btn-remove">✕</button>
              </div>
            <% } %>
          <% } else { %>
            <div class="attr-row">
              <input type="text" name="attributes_keys" placeholder="Nazwa (np. Kolor)">
              <input type="text" name="attributes_vals" placeholder="Wartość (np. Czarny)">
              <button type="button" onclick="this.parentElement.remove()" class="btn-remove">✕</button>
            </div>
          <% } %>
        </div>
        <button type="button" onclick="addAttr()" class="btn btn-sm btn-outline" style="margin-top:0.5rem">+ Dodaj atrybut</button>
      </div>

      <% if (product) { %>
        <div class="form-group">
          <label>
            <input type="checkbox" name="is_active" <%= product.is_active ? 'checked' : '' %>>
            Produkt aktywny (widoczny w sklepie)
          </label>
        </div>
      <% } %>

      <div class="form-actions">
        <button type="submit" class="btn btn-lg"><%= product ? 'Zapisz zmiany' : 'Dodaj produkt' %></button>
        <a href="/admin/products" class="btn btn-outline">Anuluj</a>
      </div>
    </form>
  </main>
</div>
<%- include('../partials/footer') %>
<script>
function addAttr() {
  const row = document.createElement('div');
  row.className = 'attr-row';
  row.innerHTML = `
    <input type="text" name="attributes_keys" placeholder="Nazwa (np. Kolor)">
    <input type="text" name="attributes_vals" placeholder="Wartość (np. Czarny)">
    <button type="button" onclick="this.parentElement.remove()" class="btn-remove">✕</button>`;
  document.getElementById('attrs-container').appendChild(row);
}
</script>
