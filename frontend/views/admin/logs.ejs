<%- include('../partials/header') %>
<div class="admin-layout">
  <%- include('./admin-nav') %>
  <main class="admin-main">
    <h1>Logi aktywności <small style="font-size:0.6em; color:var(--text-muted)">(MongoDB)</small></h1>
    <p class="text-muted">Ostatnie 100 zdarzeń — dane z kolekcji <code>activity_logs</code></p>

    <table class="data-table logs-table">
      <thead>
        <tr><th>Czas</th><th>Akcja</th><th>User ID</th><th>IP</th><th>Payload</th></tr>
      </thead>
      <tbody>
        <% logs.forEach(log => { %>
          <tr>
            <td><%= new Date(log.createdAt).toLocaleString('pl-PL') %></td>
            <td><span class="badge badge-action"><%= log.action %></span></td>
            <td><%= log.user_id || 'gość' %></td>
            <td><%= log.ip %></td>
            <td><code style="font-size:11px"><%= JSON.stringify(log.payload).substring(0,60) %></code></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>
</div>
<%- include('../partials/footer') %>
