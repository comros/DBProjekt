<%- include('../partials/header') %>
<div class="admin-layout">
  <%- include('./admin-nav') %>
  <main class="admin-main">
    <h1>Zamówienia</h1>
    <table class="data-table">
      <thead>
        <tr><th>#</th><th>Klient</th><th>Kwota</th><th>Płatność</th><th>Status</th><th>Data</th><th>Akcja</th></tr>
      </thead>
      <tbody>
        <% orders.forEach(order => { %>
          <tr>
            <td><%= order.id %></td>
            <td><%= order.user ? order.user.name : 'N/A' %></td>
            <td><%= parseFloat(order.total).toFixed(2) %> zł</td>
            <td><%= order.payment ? order.payment.method : '-' %></td>
            <td>
              <form method="POST" action="/admin/orders/<%= order.id %>/status" style="display:flex; gap:6px; align-items:center">
                <select name="status" class="select-sm">
                  <% ['pending','paid','shipped','delivered','cancelled'].forEach(s => { %>
                    <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= s %></option>
                  <% }) %>
                </select>
                <button type="submit" class="btn btn-sm">Zapisz</button>
              </form>
            </td>
            <td><%= new Date(order.created_at).toLocaleDateString('pl-PL') %></td>
            <td><a href="/orders/<%= order.id %>" class="btn btn-sm btn-outline">Podgląd</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>
</div>
<%- include('../partials/footer') %>
