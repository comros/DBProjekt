<%- include('../partials/header') %>
<div class="admin-layout">
  <%- include('./admin-nav') %>
  <main class="admin-main">
    <h1>Dashboard</h1>
    <div class="stats-grid">
      <div class="stat-card">
        <span class="stat-number"><%= totalOrders %></span>
        <span class="stat-label">Zamówień</span>
      </div>
      <div class="stat-card">
        <span class="stat-number"><%= totalUsers %></span>
        <span class="stat-label">Użytkowników</span>
      </div>
      <div class="stat-card">
        <span class="stat-number"><%= totalProducts %></span>
        <span class="stat-label">Produktów</span>
      </div>
    </div>

    <h2>Ostatnie zamówienia</h2>
    <table class="data-table">
      <thead>
        <tr><th>#</th><th>Klient</th><th>Status</th><th>Kwota</th><th>Data</th></tr>
      </thead>
      <tbody>
        <% recentOrders.forEach(order => { %>
          <tr>
            <td><%= order.id %></td>
            <td><%= order.user ? order.user.name : 'N/A' %></td>
            <td><span class="status-<%= order.status %>"><%= order.status %></span></td>
            <td><%= parseFloat(order.total).toFixed(2) %> zł</td>
            <td><%= new Date(order.created_at).toLocaleDateString('pl-PL') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>
</div>
<%- include('../partials/footer') %>
