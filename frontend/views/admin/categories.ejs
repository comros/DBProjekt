<%- include('../partials/header') %>
<div class="admin-layout">
  <%- include('./admin-nav') %>
  <main class="admin-main">
    <h1>Kategorie</h1>

    <form method="POST" action="/admin/categories/add" class="admin-form inline-form">
      <h2>Dodaj kategorię</h2>
      <div class="form-row">
        <div class="form-group">
          <label>Nazwa</label>
          <input type="text" name="name" required placeholder="np. Laptopy">
        </div>
        <div class="form-group">
          <label>Slug</label>
          <input type="text" name="slug" required placeholder="np. laptopy">
        </div>
        <div class="form-group">
          <label>Kategoria nadrzędna</label>
          <select name="parent_id">
            <option value="">Brak (główna)</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat.id %>"><%= cat.name %></option>
            <% }) %>
          </select>
        </div>
        <button type="submit" class="btn" style="align-self:flex-end">Dodaj</button>
      </div>
    </form>

    <table class="data-table" style="margin-top:2rem">
      <thead>
        <tr><th>ID</th><th>Nazwa</th><th>Slug</th><th>Nadrzędna</th><th>Akcje</th></tr>
      </thead>
      <tbody>
        <% categories.forEach(cat => { %>
          <tr>
            <td><%= cat.id %></td>
            <td><strong><%= cat.name %></strong></td>
            <td><code><%= cat.slug %></code></td>
            <td><%= cat.parent_id || '—' %></td>
            <td>
              <form method="POST" action="/admin/categories/delete/<%= cat.id %>" style="display:inline" onsubmit="return confirm('Usunąć kategorię?')">
                <button type="submit" class="btn btn-sm btn-danger">Usuń</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>
</div>
<%- include('../partials/footer') %>
