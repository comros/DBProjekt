<%- include('../partials/header') %>
<div class="auth-page">
  <div class="auth-card">
    <h1>Zaloguj się</h1>
    <% if (errors.length) { %>
      <div class="alert-error">
        <% errors.forEach(e => { %><p><%= e %></p><% }) %>
      </div>
    <% } %>
    <form method="POST" action="/auth/login">
      <div class="form-group">
        <label>E-mail</label>
        <input type="email" name="email" required>
      </div>
      <div class="form-group">
        <label>Hasło</label>
        <input type="password" name="password" required>
      </div>
      <button type="submit" class="btn btn-full">Zaloguj</button>
    </form>
    <p class="auth-hint">Testowe konta:<br>
      <code>admin@sklep.pl</code> / <code>admin123</code><br>
      <code>jan@kowalski.pl</code> / <code>user123</code>
    </p>
    <p class="auth-link">Nie masz konta? <a href="/auth/register">Zarejestruj się</a></p>
  </div>
</div>
<%- include('../partials/footer') %>
