<%- include('../partials/header') %>
<div class="container section">
  <a href="/orders/my" class="back-link">← Wróć do zamówień</a>
  <h1 class="page-title">Zamówienie #<%= order.id %></h1>

  <div class="order-detail-grid">
    <div class="order-detail-card">
      <h3>Status zamówienia</h3>
      <span class="order-status-big status-<%= order.status %>"><%= order.status %></span>
      <p>Data: <%= new Date(order.created_at).toLocaleString('pl-PL') %></p>
      <p>Adres: <%= order.shipping_address %></p>
    </div>

    <% if (order.payment) { %>
    <div class="order-detail-card">
      <h3>Płatność</h3>
      <p>Metoda: <strong><%= order.payment.method %></strong></p>
      <p>Status: <span class="status-<%= order.payment.status %>"><%= order.payment.status %></span></p>
      <p>Kwota: <strong><%= parseFloat(order.payment.amount).toFixed(2) %> zł</strong></p>
    </div>
    <% } %>
  </div>

  <h2 style="margin-top:2rem">Produkty</h2>
  <table class="data-table">
    <thead>
      <tr><th>Produkt</th><th>Ilość</th><th>Cena jedn.</th><th>Suma</th></tr>
    </thead>
    <tbody>
      <% order.items.forEach(item => { %>
        <tr>
          <td><%= item.product_name %></td>
          <td><%= item.quantity %></td>
          <td><%= parseFloat(item.unit_price).toFixed(2) %> zł</td>
          <td><%= (item.quantity * item.unit_price).toFixed(2) %> zł</td>
        </tr>
      <% }) %>
    </tbody>
    <tfoot>
      <tr><td colspan="3"><strong>Łącznie</strong></td><td><strong><%= parseFloat(order.total).toFixed(2) %> zł</strong></td></tr>
    </tfoot>
  </table>
</div>
<%- include('../partials/footer') %>
